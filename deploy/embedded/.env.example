# Copy to .env for a single-node relay. Keep the data volume and relay URL stable.
BUZZ_IMAGE=ghcr.io/chesapeakedev/buzz:main
BUZZ_DOMAIN=buzz.example.com
RELAY_URL=wss://buzz.example.com
BUZZ_PAIRING_DOMAIN=pairing.buzz.example.com
BUZZ_PAIRING_RELAY_URL=wss://pairing.buzz.example.com
# Publicly advertised through the relay's NIP-11 information document.
RELAY_CONTACT=owner@example.com
RELAY_ACCESS=closed
# Accepts the npub shown by Buzz Desktop or the equivalent 64-character hex.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_NPUB_OR_HEX
BUZZ_REQUIRE_AUTH_TOKEN=true
# Admit owner-attested agents to a closed relay through NIP-OA.
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_GIT_ENABLED=false
BUZZ_SERVE_GIT_WEB_GUI=true
BUZZ_HTTP_PORT=3000
BUZZ_PAIRING_PORT=5000
BUZZ_SQLITE_CORE_POOL_SIZE=8
BUZZ_SQLITE_CHANNEL_POOL_SIZE=4
BUZZ_SQLITE_SEARCH_POOL_SIZE=2
BUZZ_SQLITE_READ_CACHE_TTL_MS=3000
BUZZ_SQLITE_READ_QUEUE_TIMEOUT_MS=5000
# Used only with compose.cloudflare.yml. Copy the token from the Cloudflare
# tunnel's connector setup command; never commit the populated .env file.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
