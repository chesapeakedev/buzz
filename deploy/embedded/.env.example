# Copy to .env for a single-node relay. Keep the data volume and relay URL stable.
BUZZ_IMAGE=ghcr.io/chesapeakedev/buzz:main
BUZZ_DOMAIN=buzz.example.com
RELAY_URL=wss://buzz.example.com
RELAY_ACCESS=closed
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_GIT_ENABLED=false
BUZZ_HTTP_PORT=3000
BUZZ_SQLITE_CORE_POOL_SIZE=8
BUZZ_SQLITE_CHANNEL_POOL_SIZE=4
BUZZ_SQLITE_SEARCH_POOL_SIZE=2
BUZZ_SQLITE_READ_CACHE_TTL_MS=3000
BUZZ_SQLITE_READ_QUEUE_TIMEOUT_MS=5000
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
